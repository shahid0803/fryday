# Server environment configuration for NOVA (Fryday)
# NEVER commit the actual .env file or real API keys to Git.

# OpenAI API key for Realtime Voice / Audio sessions
OPENAI_API_KEY=your_openai_api_key_here

# Meshy API key for Text-to-3D model generation
MESHY_API_KEY=your_meshy_api_key_here

# Development mock flag: set to 'true' in development to simulate 3D generation without provider credits
ENABLE_3D_MOCKS=false

# Backend server port (default 3001, proxied by Vite dev server via /api)
PORT=3001
